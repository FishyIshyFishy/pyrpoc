# Multisite, board 2 of 2: inside one loop run. Left: what reaches it. Middle: what multisite
# keeps to itself. Right: what it publishes, and the scratch it keeps until it finishes.
vars: {d2-config: {layout-engine: elk}}
direction: right

classes: {
  input: {style: {fill: "#fff3d6"; stroke: "#c79200"; border-radius: 6}}
  request: {style: {fill: "#ffe7c2"; stroke: "#d9730d"; stroke-width: 2; border-radius: 6}}
  inner: {style: {fill: "#f4fbf5"; stroke: "#3c8d4f"; border-radius: 6}}
  check: {shape: hexagon; style: {fill: "#e8f0fb"; stroke: "#3b6db3"}}
  out: {style: {fill: "#f3ecfa"; stroke: "#7e57a8"; border-radius: 6}}
  disk: {shape: cylinder; style: {fill: "#eeeeee"; stroke: "#777777"}}
  scratch: {shape: cylinder; style: {fill: "#e3f2e6"; stroke: "#3c8d4f"; stroke-dash: 3}}
}

legend: |md
  **Identity.** A unit's *key* is made once, by `Unit.new()`, wherever the unit comes from
  (drawn, or found by software) and never reused. Its *number* is what people see: the
  roster gives one as the unit joins, and never gives it again. Deleting unit 3 and drawing
  it again makes a new key, so the loop runs it as unit 4.

  **Collapse.** Stopped or cut short, the loop leaves its scratch. Starting it again in that
  folder replays the scratch and carries on: each routine from its history, each unit from
  where it was last found.
| {near: bottom-left}

units: "UNITS\nthe units drawn" {class: input}
command: "UNIT_COMMAND\nAddUnit, EditUnit, RemoveUnit,\nPauseUnit, ResumeUnit, RunUnitNow" {class: request}
survey: "survey + calibration\nread -> SurveyMap, FieldOfView" {class: input}

multisite: "multisite (programs/building_blocks/multisite): no panel sees inside" {
  style: {fill: "#fbfefb"; stroke: "#3c8d4f"; stroke-width: 2}

  begin: "begin\nscratch in the folder?\nyes: resume(resumption(events))\nno: start(UNITS)" {class: inner}
  steering: "RunSteering\n.commands()" {class: inner}
  orch: "Orchestrator\nthreads: one per (unit, routine)\nearliest due first; commands\ntaken between steps, refused\nones logged" {class: inner}
  roster: "Roster\nkey -> UnitRecord\nnumbers never given twice" {class: inner}
  routines: "routine, e.g. monitor\nstart(unit, RoutineHistory)\nyields Scan / Wait / Record" {class: inner}
  scanner: "UnitScanner\nfocus, scan, find the unit\n(a new outline: learn its\nlook from the next scan)" {class: inner}
  sink: "LoopOutputs\nevery event to the log\nand to the scratch" {class: inner}

  begin -> orch
  steering -> orch: "UnitCommand"
  orch -> roster: "join, edit,\nleave, pause"
  orch -> routines: "next step"
  orch -> scanner: "Scan"
  orch -> sink: "LoopEvent"
  scanner -> sink: "frame,\nUnitScanned"
  roster -> sink: "UnitRecords"
}

units -> multisite.begin: "fresh start only"
command -> multisite.steering
survey -> multisite.begin

log: "'log' LoopLogOutput\nthe whole loop, from its\nfirst event, even when\ncarried on" {class: out}
unit_records: "'units' UnitsOutput" {class: out}
frames: "'frames' UnitFramesOutput" {class: out}
multisite.sink -> log
multisite.sink -> unit_records
multisite.sink -> frames

folder: "save folder" {
  style: {fill: "#fafafa"; stroke: "#777777"}
  tiffs: "<routine>/unit<number>.tiff\nadded to, never replaced" {class: disk}
  scratch: "loop_scratch.jsonl\nthe runs of this loop + every event\ngone once every routine has ended" {class: scratch}
}
frames -> folder.tiffs
multisite.sink -> folder.scratch: "append"
folder.scratch -> multisite.begin: "carry on" {style.stroke-dash: 4}

clean: "CleanFolder(carries_on=True)\nallows the runs the\nscratch names" {class: check}
folder.scratch -> clean {style.stroke-dash: 4}
