# Board 1 of 2: what flows into a program and what comes out. See nouns.d2 for the nouns.
direction: right

classes: {
  coll: {style: {fill: "#fff3d6"; stroke: "#c79200"; stroke-width: 3; border-radius: 6}}
  prog: {style: {fill: "#e6f5e9"; stroke: "#3c8d4f"; stroke-width: 3; border-radius: 6}}
  inbox: {style: {fill: "#e8f0fb"; stroke: "#3b6db3"; stroke-width: 2; border-radius: 6}}
  val: {style: {fill: "#f3ecfa"; stroke: "#7e57a8"; border-radius: 6}}
  view: {style: {fill: "#fde8e8"; stroke: "#b04a4a"; border-radius: 6}}
  disk: {shape: cylinder; style: {fill: "#eeeeee"; stroke: "#777777"}}
}

settings: "ProgramInputs\nthe user's settings" {class: coll}
devices: "Devices\nhardware claimed\nfor the run" {class: coll}
requests: "Requests\ncommands panels post" {class: coll}
earlier: "Earlier outputs\nonly if the program\ndeclares `reads`" {class: val}

inbox: "Inbox, one per run\neverything posted to it,\neach taken at its moment\nand logged" {class: inbox}

run: "Run\nprogram.run(ctx)\nctx is its only door" {class: prog}

recording: "Recording\nits parts, each with the\nsettings it ran with,\nand their ProgramOutputs" {class: val}
library: "Library\nthe open recordings" {class: coll}
files: "files on disk\n(if saving is on)" {class: disk}
panels: "Panels\nshow outputs,\nset settings, post requests" {class: view}

settings -> run: "values at start"
devices -> run
earlier -> run

settings -> inbox: "edits"
devices -> inbox: "edits"
requests -> inbox: "posted"
inbox -> run: "a request: when asked\na live input: when read\nany other edit: between\npasses, as a new part"

run -> recording
recording -> library
recording -> files: "as it fills"
earlier -- files: "a later run reads it" {source-arrowhead.shape: triangle}
library -> panels
settings -- panels: "mask drawn, pixel picked" {source-arrowhead.shape: triangle; style.stroke: "#b04a4a"}
requests -- panels: "visit this unit now" {source-arrowhead.shape: triangle; style.stroke: "#b04a4a"}
