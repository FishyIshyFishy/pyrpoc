# Board 1 of 2: what flows into a program and what comes out. See nouns.d2 for the nouns.
direction: right

classes: {
  coll: {style: {fill: "#fff3d6"; stroke: "#c79200"; stroke-width: 3; border-radius: 6}}
  prog: {style: {fill: "#e6f5e9"; stroke: "#3c8d4f"; stroke-width: 3; border-radius: 6}}
  inbox: {style: {fill: "#e8f0fb"; stroke: "#3b6db3"; stroke-width: 2; border-radius: 6}}
  val: {style: {fill: "#f3ecfa"; stroke: "#7e57a8"; border-radius: 6}}
  view: {style: {fill: "#fde8e8"; stroke: "#b04a4a"; border-radius: 6}}
  disk: {shape: cylinder; style: {fill: "#eeeeee"; stroke: "#777777"}}
  check: {shape: hexagon; style: {fill: "#e8f0fb"; stroke: "#3b6db3"}}
}

settings: "ProgramInputs" {class: coll}
devices: "Devices" {class: coll}

inbox: "Inbox" {class: inbox}

preflight: "Preflight" {class: check}

run: "Run" {class: prog}

recording: "Recording\n (many consituent ProgramOutputs of 1 run)" {class: val}
library: "Library" {class: coll}
files: "files on disk" {class: disk}
panels: "Panels" {class: view}

settings -> preflight
devices -> preflight
library -> preflight
preflight -> run

settings -> inbox: "edits"
devices -> inbox: "edits"
inbox -> run

run -> recording
recording -> library
recording -> files: "as it fills"
library -> panels
settings -- panels: "mask drawn, pixel picked,\nunits edited as a loop runs" {source-arrowhead.shape: triangle; style.stroke: "#b04a4a"}
