# Multisite, board 1 of 2: the pipeline. Each step's inputs, the program, the outputs it fills,
# and what later steps and panels read of them. See multisite_loop.d2 for inside a loop.
vars: {d2-config: {layout-engine: elk}}
direction: right

classes: {
  input: {style: {fill: "#fff3d6"; stroke: "#c79200"; border-radius: 6}}
  live: {style: {fill: "#fff3d6"; stroke: "#c79200"; stroke-width: 3; stroke-dash: 3; border-radius: 6}}
  request: {style: {fill: "#ffe7c2"; stroke: "#d9730d"; stroke-width: 2; border-radius: 6}}
  prog: {style: {fill: "#e6f5e9"; stroke: "#3c8d4f"; stroke-width: 3; border-radius: 6}}
  check: {shape: hexagon; style: {fill: "#e8f0fb"; stroke: "#3b6db3"}}
  out: {style: {fill: "#f3ecfa"; stroke: "#7e57a8"; border-radius: 6}}
  panel: {style: {fill: "#fde8e8"; stroke: "#b04a4a"; border-radius: 6}}
  panel_new: {style: {fill: "#fde8e8"; stroke: "#b04a4a"; stroke-dash: 4; border-radius: 6}}
  library: {style: {fill: "#fffaf0"; stroke: "#c79200"; stroke-width: 3; border-radius: 6}}
}

# A node in the layout rather than pinned to a corner, which reserved a band of empty space.
key: |md
  **Key**
  - yellow: ProgramInputs (dashed: *live*)
  - orange: Request
  - green: program
  - purple: ProgramOutput
  - bold yellow box: the Library,
    which holds every output
  - red: panel (dashed: #67)

  A step reads earlier outputs by type,
  from its folder.
| {style: {fill: "#ffffff"; stroke: "#bbbbbb"}}

clean: "CleanFolder, on every step\nthe folder holds only what the\nstep reads (a loop's: also the\nruns of a loop it carries on)" {class: check}
clean -> cal {style.stroke-dash: 4}
clean -> sur {style.stroke-dash: 4}
clean -> loop {style.stroke-dash: 4}

# ---------------------------------------------------------------- 1. calibration
cal_in: "SCAN_GEOMETRY_INPUTS" {class: input}
cal: "1. Galvo Calibration" {class: prog}
cal_in -> cal
cal -> library.calibration
cal -> library.view

# ---------------------------------------------------------------- 2. survey
sur_in: "SURVEY_WIDTH/HEIGHT_UM\nFIELD_UM, FIELD_PIXELS\nTILE_OVERLAP, focus search" {class: input}
sur: "2. Survey\nreads 'calibration'" {class: prog}
sur_in -> sur
sur -> library.survey

# ---------------------------------------------------------------- 3. loop
units: "UNITS: tuple[Unit]\nthe units it starts on\nUnit = key + outline + group" {class: input}
loop_in: "TREAT, TREATED_GROUP\nFOCUS_CHECK_S, ..." {class: input}
monitor_live: "PERIOD_S, DURATION_MIN" {class: live}
command: "UNIT_COMMAND\nadd, edit, remove, pause,\nresume, run now (by key)" {class: request}
loop: "3. Longitudinal Monitor\n(any loop: routines on units)\nreads 'survey' -> SurveyMap,\n'calibration' -> FieldOfView" {class: prog}
units -> loop: "fresh start"
loop_in -> loop
monitor_live -> loop
command -> loop: "while it runs"
loop -> library.log
loop -> library.unit_records
loop -> library.frames

# ---------------------------------------------------------------- the library
# Every output a program fills is in the library, inside its recording; panels only ever
# reach an output there, each picking the outputs of the type it renders.
library: "Library: the open recordings and all their outputs" {
  class: library
  calibration: "'calibration'\nGalvoCalibrationOutput\n.measured() -> GalvoCalibration\n(µm per volt, x and y)" {class: out}
  view: "'view' ImageOutput\nevery frame it looked at" {class: out}
  survey: "'survey'\nSurveyOutput (a MosaicOutput)\n.found() -> SurveyFinding\n  (FocusPlane, MotionRate)\n.overview() -> (planes, Placement)" {class: out}
  log: "'log' LoopLogOutput\nevery LoopEvent\n.view() -> LoopView" {class: out}
  unit_records: "'units' UnitsOutput\nevery UnitRecord\n(number, Unit, joined, left, paused)" {class: out}
  frames: "'frames' UnitFramesOutput\neach frame tagged FrameTag\n(unit number, routine, position)" {class: out}
}

# ---------------------------------------------------------------- panels
image: "Image panel\nrenders ImageOutput" {class: panel}
mosaic: "Mosaic panel\nrenders MosaicOutput" {class: panel}
data_library: "Data Library panel\nlists every recording" {class: panel}
autonomy: "Autonomy (#67)\nrenders SurveyOutput;\ndraws Unit.new() over the overview" {class: panel_new}
curves: "Curves (#67)\nrenders LoopLogOutput" {class: panel_new}
library.view -> image
library.frames -> image: "an ImageOutput too"
library.survey -> mosaic: "a MosaicOutput"
library.survey -> autonomy: ".overview()"
library.log -> autonomy: ".view(): units as tracked"
library.log -> curves: ".view(): UnitView.series"
library -> data_library

# What the Autonomy panel sends back: units to start on, and commands while a loop runs.
units -- autonomy: "before a loop" {source-arrowhead.shape: triangle; style.stroke: "#b04a4a"}
command -- autonomy: "while it runs" {source-arrowhead.shape: triangle; style.stroke: "#b04a4a"}
