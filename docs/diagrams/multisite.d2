# Multisite, board 1 of 2: the pipeline. Each step's inputs, the program, the outputs it fills,
# and what later steps and panels read of them. See multisite_loop.d2 for inside a loop.
vars: {d2-config: {layout-engine: elk}}
direction: right

classes: {
  input: {style: {fill: "#fff3d6"; stroke: "#c79200"; border-radius: 6}}
  live: {style: {fill: "#fff3d6"; stroke: "#c79200"; stroke-width: 3; stroke-dash: 3; border-radius: 6}}
  prog: {style: {fill: "#e6f5e9"; stroke: "#3c8d4f"; stroke-width: 3; border-radius: 6}}
  check: {shape: hexagon; style: {fill: "#e8f0fb"; stroke: "#3b6db3"}}
  out: {style: {fill: "#f3ecfa"; stroke: "#7e57a8"; border-radius: 6}}
  panel: {style: {fill: "#fde8e8"; stroke: "#b04a4a"; border-radius: 6}}
  panel_new: {style: {fill: "#fde8e8"; stroke: "#b04a4a"; stroke-dash: 4; border-radius: 6}}
  library: {style: {fill: "#fffaf0"; stroke: "#c79200"; stroke-width: 3; border-radius: 6}}
}

# A node in the layout rather than pinned to a corner, which reserved a band of empty space.
key: |md
  **Key**
  - yellow: ProgramInputs (dashed: *live*)
  - green: program
  - purple: ProgramOutput
  - bold yellow box: the Library,
    which holds every output
  - red: panel (dashed: planned)
  - blue: a check, refusing a start
    before its recording opens

  A step's earlier outputs are program
  inputs, set by the engine to the newest
  of their type in its folder.
| {style: {fill: "#ffffff"; stroke: "#bbbbbb"}}

clean: "clean_folder, on every step\nthe folder holds only what the\nstep reads (a loop's: also the\nruns of a loop it carries on)" {class: check}
clean -> cal {style.stroke-dash: 4}
clean -> sur {style.stroke-dash: 4}
clean -> loop {style.stroke-dash: 4}
measured: "calibration_measured\nthe calibration read\nran to its end" {class: check}
measured -> sur {style.stroke-dash: 4}
measured -> loop {style.stroke-dash: 4}
finished: "survey_finished\nthe survey read\nran to its end" {class: check}
finished -> loop {style.stroke-dash: 4}
starting: "starting_units\nfresh: units drawn, each\nfitting in one field;\ncarried on: none drawn" {class: check}
starting -> loop {style.stroke-dash: 4}

# ---------------------------------------------------------------- 1. calibration
cal_in: "SCAN_GEOMETRY_INPUTS" {class: input}
cal: "1. Galvo Calibration\n(any CalibrationProgram)" {class: prog}
cal_in -> cal
cal -> library.calibration
cal -> library.view
cal -> library.cal_log

# ---------------------------------------------------------------- 2. survey
sur_in: "SURVEY_WIDTH/HEIGHT_UM\nFIELD_UM, FIELD_PIXELS\nTILE_OVERLAP, focus search" {class: input}
sur: "2. Survey (any SurveyProgram)\ninput CALIBRATION" {class: prog}
sur_in -> sur
sur -> library.survey
sur -> library.survey_log

# ---------------------------------------------------------------- 3. loop
units: "UNITS: tuple[Unit]\nthe units it runs on, live\nUnit = key + outline + group\n+ paused + run_now_asked" {class: live}
loop_in: "TREAT, TREATED_GROUP\nFOCUS_CHECK_S, ..." {class: input}
monitor_live: "PERIOD_S, DURATION_MIN" {class: live}
loop: "3. Longitudinal Monitor\n(any LoopProgram: routines on units)\ninputs SURVEY -> SurveyMap,\nCALIBRATION -> FieldOfView" {class: prog}
units -> loop: "at start, and between steps"
loop_in -> loop
monitor_live -> loop
loop -> library.log
loop -> library.unit_records
loop -> library.frames

# ---------------------------------------------------------------- the library
# Every output a program fills is in the library, inside its recording; panels only ever
# reach an output there, each picking the outputs of the type it renders.
library: "Library: the open recordings and all their outputs" {
  class: library
  calibration: "'calibration'\nGalvoCalibrationOutput\n.measured() -> GalvoCalibration\n(µm per volt, x and y)" {class: out}
  view: "'view' ImageOutput\nevery frame it looked at" {class: out}
  cal_log: "'log' CalibrationLogOutput\n(a LogOutput)\nevery move it made" {class: out}
  survey: "'survey'\nSurveyOutput (a MosaicOutput)\n.found() -> SurveyFinding\n  (FocusPlane, MotionRate)\n.overview() -> (planes, Placement)" {class: out}
  survey_log: "'log' SurveyLogOutput\n(a LogOutput)\neach tile visited, focused, taken" {class: out}
  log: "'log' LoopLogOutput (a LogOutput)\nevery LoopEvent, with moving,\nfocusing and scanning as begun\n.view() -> LoopView (.doing)" {class: out}
  unit_records: "'units' UnitsOutput\nevery UnitRecord\n(number, Unit, joined, left)" {class: out}
  frames: "'frames' UnitFramesOutput\neach frame tagged FrameTag\n(unit number, routine, position)" {class: out}
}

# ---------------------------------------------------------------- panels
image: "Image panel\nrenders ImageOutput" {class: panel}
mosaic: "Mosaic panel\nrenders MosaicOutput" {class: panel}
data_library: "Data Library panel\nlists every recording" {class: panel}
multisite_panel: "Multisite panel (planned)\nreads the logs, 'survey',\n'units' and 'frames';\nsets UNITS" {class: panel_new}
library.view -> image
library.frames -> image: "an ImageOutput too"
library.survey -> mosaic: "a MosaicOutput"
library.survey -> multisite_panel: ".overview()"
library.cal_log -> multisite_panel
library.survey_log -> multisite_panel
library.log -> multisite_panel: "events, .view().doing"
library.unit_records -> multisite_panel
library.frames -> multisite_panel
library -> data_library

# What the multisite panel will send back: the units, before and while a loop runs.
units -- multisite_panel: "units drawn and edited" {source-arrowhead.shape: triangle; style.stroke: "#b04a4a"; style.stroke-dash: 4}
